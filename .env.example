# Копирайте като .env и попълнете. .env НЕ се качва в git.

# ---- Google Drive ----
# Линк или ID на папка, в която да се качва, напр.:
#   GDRIVE_FOLDER=https://drive.google.com/drive/folders/1AbCdEfGhIjKlMnOpQrStUvWxYz
# Оставете празно, за да създаде приложението папка "Hidden Camera" в My Drive
# (препоръчително — изисква по-тесни права, само drive.file).
GDRIVE_FOLDER=

# ---- Telegram (по желание: известия със снимка и/или клипове) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
