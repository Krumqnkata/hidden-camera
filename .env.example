# Копирайте като .env и попълнете. .env НЕ се качва в git.

# ---- Google Drive чрез линк (UPLOAD_METHOD = "apps script") ----
# Попълват се АВТОМАТИЧНО от:  .venv\Scripts\python main.py --setup-script
GDRIVE_SCRIPT_URL=
GDRIVE_SCRIPT_SECRET=

# ---- Google Drive API (само за UPLOAD_METHOD = "google drive api") ----
# Линк или ID на папка. Празно -> приложението създава "Hidden Camera" в My Drive.
GDRIVE_FOLDER=

# ---- Telegram (по желание: известия със снимка и/или клипове) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
